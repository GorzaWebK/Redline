{
  "rules": {
    ".read": false,
    ".write": false,
    "redline": {
      "scores": {
        "$track": {
          ".read": "$track.matches(/^(t([1-9]|[12][0-9]|30)|d20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|w20[0-9]{2}(0[1-9]|[1-4][0-9]|5[0-3])|u[A-Za-z0-9]{6,12})(_(gt|hatch|muscle|hyper))?$/)",
          ".indexOn": [
            "time"
          ],
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('redline').child('members').child($uid).child(auth.uid).exists()) && $track.matches(/^(t([1-9]|[12][0-9]|30)|d20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|w20[0-9]{2}(0[1-9]|[1-4][0-9]|5[0-3])|u[A-Za-z0-9]{6,12})(_(gt|hatch|muscle|hyper))?$/)",
            ".validate": "newData.hasChildren(['name', 'time', 'lap', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9 _.-]+$/)"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 40 && newData.val() < 3600 && (!data.exists() || newData.val() <= data.val())"
            },
            "lap": {
              ".validate": "newData.isNumber() && newData.val() >= 12 && newData.val() * 3 <= newData.parent().child('time').val() + 0.01"
            },
            "car": {
              ".validate": "newData.isString() && newData.val().matches(/^(gt|hatch|muscle|hyper)$/) && (!$track.contains('_') || $track.endsWith('_' + newData.val()))"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "ghosts": {
        "$track": {
          ".read": "$track.matches(/^(t([1-9]|[12][0-9]|30)|d20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|w20[0-9]{2}(0[1-9]|[1-4][0-9]|5[0-3])|u[A-Za-z0-9]{6,12})(_(gt|hatch|muscle|hyper))?$/)",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('redline').child('members').child($uid).child(auth.uid).exists()) && $track.matches(/^(t([1-9]|[12][0-9]|30)|d20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])|w20[0-9]{2}(0[1-9]|[1-4][0-9]|5[0-3])|u[A-Za-z0-9]{6,12})(_(gt|hatch|muscle|hyper))?$/)",
            ".validate": "newData.hasChildren(['time', 'data', 'at']) && newData.child('time').val() === newData.parent().parent().parent().child('scores').child($track).child($uid).child('time').val()",
            "time": {
              ".validate": "newData.isNumber()"
            },
            "data": {
              ".validate": "newData.isString() && newData.val().length <= 150000 && newData.val().beginsWith('R1.')"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "accounts": {
        "$code": {
          ".read": "auth != null && $code.matches(/^[2-9A-HJ-NP-Z]{16}$/)",
          ".write": "auth != null && newData.exists()",
          ".validate": "$code.matches(/^[2-9A-HJ-NP-Z]{16}$/) && newData.hasChildren(['pid', 'save', 'at']) && newData.child('pid').val() === (data.exists() ? data.child('pid').val() : auth.uid) && newData.child('at').val() === now && (!data.exists() || now - data.child('at').val() >= 2000)",
          "pid": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,128}$/)"
          },
          "save": {
            ".validate": "newData.isString() && newData.val().length <= 300000 && newData.val().beginsWith('RS1.')"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "members": {
        "$pid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[2-9A-HJ-NP-Z]{16}$/) && root.child('redline').child('accounts').child(newData.val()).child('pid').val() === $pid"
          }
        }
      },
      "community": {
        ".read": true,
        ".indexOn": [
          "at",
          "likes"
        ],
        "$id": {
          ".write": "auth != null && $id.matches(/^[a-z2-9]{8}$/) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['name', 'author', 'pts', 'theme', 'width', 'hills', 'gold', 'uid', 'at', 'likes'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9 _.-]+$/)"
          },
          "author": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9 _.-]+$/)"
          },
          "pts": {
            ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^-?[0-9]{1,4},-?[0-9]{1,4}(;-?[0-9]{1,4},-?[0-9]{1,4}){3,39}$/)"
          },
          "theme": {
            ".validate": "newData.isString() && newData.val().matches(/^(meadow|canyon|alpine|night|riviera)$/)"
          },
          "width": {
            ".validate": "newData.isString() && newData.val().matches(/^(narrow|normal|wide)$/)"
          },
          "hills": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
          },
          "gold": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() < 1200"
          },
          "uid": {
            ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
          },
          "at": {
            ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === now"
          },
          "likes": {
            ".write": "auth != null && data.exists()",
            ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 0 : (newData.val() === data.val() + 1 && !root.child('redline').child('votes').child($id).child(auth.uid).exists() && newData.parent().parent().parent().child('votes').child($id).child(auth.uid).val() === true))"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "votes": {
        "$id": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === true && root.child('redline').child('community').child($id).exists()"
          }
        }
      }
    }
  }
}
